# Serveroid API credentials
SERVEROID_CLIENT_ID=your_client_id
SERVEROID_API_KEY=your_api_key

# VM selection
SERVEROID_TENANT_ID=your_tenant_id
SERVEROID_VM_ID=your_vm_id
# SERVEROID_VM_NAME=dev-rails

# Optional tuning
SERVEROID_API_BASE=https://api.flops.ru/api/v1
SERVEROID_TIMEOUT=20
SERVEROID_POLL_INTERVAL=3
SERVEROID_OP_WAIT_TIMEOUT=300
